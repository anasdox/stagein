# Public entry point.
#
# The hostname OVH assigns resolves publicly and its reverse matches, so Caddy
# gets a Let's Encrypt certificate for it on first boot — no domain to buy, no
# certbot to schedule, and `wss://` works because it is the same TLS.
#
# The relay itself is never published: it only listens on the compose network.

{$STAGEIN_DOMAIN} {
	encode zstd gzip

	# WebSocket upgrades are proxied natively; the relay reads X-Forwarded-For
	# for its per-IP limits, which is why Caddy sets it.
	reverse_proxy relay:8080 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}

	header {
		# The pages are same-origin only and embed nothing remote.
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		# The stage view is meant to be embedded in OBS, so framing stays open
		# to the same origin rather than denied outright.
		X-Frame-Options "SAMEORIGIN"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output stdout
		format console
	}
}
