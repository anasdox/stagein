# --- Relay -------------------------------------------------------------------
PORT=8080

# Public base URL burned into the QR code / join link.
# In a hall, put the LAN IP or the tunnel hostname here, otherwise phones
# will scan a QR pointing at "localhost" and reach nothing.
#   PUBLIC_BASE_URL=http://192.168.1.42:8080
PUBLIC_BASE_URL=http://localhost:8080

# Bootstrap session created at relay startup so the stack is usable
# immediately (and so the Norns simulator can auto-pair).
BOOTSTRAP_SESSION_ID=DEMO01
BOOTSTRAP_HOST_TOKEN=dev-host-token-change-me
BOOTSTRAP_NORNS_TOKEN=dev-norns-token-change-me

LOG_LEVEL=info

# --- Norns simulator ---------------------------------------------------------
NORNS_PORT=8081
RELAY_WS_URL=ws://localhost:8080/ws/norns
STAGEIN_SESSION=DEMO01
STAGEIN_NORNS_TOKEN=dev-norns-token-change-me

# latch   = K3 press arms, double-tap kills (usable on stage, default)
# deadman = K3 must be held to stay armed, release kills (literal PRD reading)
ARM_MODE=latch

# log | osc | midi   (midi requires the optional native "easymidi" dependency)
MIDI_BACKEND=log
OSC_HOST=127.0.0.1
OSC_PORT=57120
